ADMIN_EMAIL=admin@example.com
# openssl rand -base64 32
SESSION_SECRET=generate-with-openssl-rand-hex-32

# First-run seed values (optional — only used to populate the database once,
# on first boot when it's empty; after that, edit the real values via /admin
# instead of here). Leave unset to start with generic placeholder text.
SEED_ACCOUNT_NAME="Your Account Name"
SEED_BANK_NAME_OFFICIAL_EN="Your Bank Name"
SEED_BANK_NAME_OFFICIAL_AR=""
SEED_ACCOUNT_TYPE_EN="Account Type"
SEED_ACCOUNT_TYPE_AR=""
SEED_IBAN=
SEED_ACCOUNT_NUMBER=
SEED_SWIFT_CODE=

# Email (SMTP)
EMAIL_FROM="Your Company <no-reply@example.com>"
EMAIL_SMTP_HOST=smtp.example.com
EMAIL_SMTP_PORT=465
EMAIL_SMTP_USER=no-reply@example.com
EMAIL_SMTP_PASSWORD=
EMAIL_SMTP_SECURE=true
